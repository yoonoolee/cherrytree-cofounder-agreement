{
  // Shared compiler options. Each package extends this and adds only its own
  // libs/types/paths. Nothing here emits: Vite bundles `apps/web`, esbuild bundles
  // `apps/functions`, and `packages/shared` is consumed as source through both.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    // Off on purpose: Firestore documents are read with optional fields that may
    // legitimately hold `undefined`.
    "exactOptionalPropertyTypes": false
  }
}
