rules_version = '2';

// Client access is deliberately narrow: Cloud Functions (Admin SDK, which bypasses these
// rules) own every document's lifecycle and every field that carries money or membership.
// Guarded by apps/functions/test/rules/firestore.rules.test.ts (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // users/{clerkUserId}: readable by its owner, written only by the Clerk webhook and
    // createCheckoutSession (stripeCustomerId).
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // projects/{clerkOrgId}
    match /projects/{projectId} {
      // Any role; agent actions check the role server-side.
      function isMember() {
        return request.auth.uid in resource.data.members;
      }

      // Per-user preferences the app writes from the browser. Everything else — members,
      // payments, currentPlan, name, ... — is written server-side only.
      function onlyClientFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastOpened', 'onboardingCompleted'
        ]);
      }

      // Created by the Stripe webhook; never deleted from the client.
      allow create, delete: if false;

      allow get: if isSignedIn() && isMember();

      // The app loads projects one by one from the user's Clerk memberships.
      allow list: if false;

      allow update: if isSignedIn() && isMember() && onlyClientFields();
    }

    // Public pro-plan waitlist: anonymous signup with exactly the fields the form sends.
    match /proWaitlist/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'timestamp', 'source']) &&
                      request.resource.data.email is string &&
                      request.resource.data.email.size() <= 254 &&
                      request.resource.data.email.matches('.+@.+') &&
                      request.resource.data.timestamp == request.time &&
                      request.resource.data.source is string &&
                      request.resource.data.source.size() <= 100;
      allow read, update, delete: if false;
    }

    // Everything else (including stripeEvents) is server-side only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
