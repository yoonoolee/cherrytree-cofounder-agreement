# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# This file is committed to Git and contains NO real keys
# Copy to web/.env.dev (local dev + dev hosting) or web/.env.production (prod)
# Vite loads .env.dev for `--mode dev` and .env.production for `vite build`
# Only variables prefixed VITE_ are exposed to the browser bundle
# =============================================================================

# Google Places API Key
# Get your API key from: https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase Configuration
# Get these from: Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# reCAPTCHA v3 (for Firebase App Check - Site key is safe to expose)
# Get from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Stripe Configuration (Frontend - Publishable key is safe to expose)
# Development: Use test keys (pk_test_...)
# Production: Use live keys (pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
VITE_STRIPE_STARTER_PRICE_ID=price_your_starter_price_id
VITE_STRIPE_PRO_PRICE_ID=price_your_pro_price_id

# Security Configuration
VITE_ENFORCE_HTTPS=false

# Clerk Authentication
# Development: Use test keys from development instance
# Production: Use live keys from production instance
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# App URLs (marketing site and app host)
VITE_MARKETING_URL=https://cherrytree.app
VITE_APP_URL=https://my.cherrytree.app

# Sentry error tracking (optional; disabled when empty)
VITE_SENTRY_DSN=

# Connect to local Firebase emulators in dev mode (optional)
VITE_USE_EMULATORS=false
